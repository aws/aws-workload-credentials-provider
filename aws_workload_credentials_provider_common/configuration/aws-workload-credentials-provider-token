#!/bin/bash
# A failed step must fail the script, however it is run, and a failed dd must
# not leave the hash of empty input as the token.
set -eo pipefail

PATH=/bin:/usr/bin:/sbin:/usr/sbin
TOKENFILE=/var/run/awssmatoken
TOKENGROUP=aws-wcp-token
case "$1" in
    start)
        echo -e "Initializing SSRF token"
        # mktemp creates the file readable by root only, so no other user can
        # open it before it holds the token and has its final group and mode.
        # mv then swaps it in whole, replacing any old token file.
        TMPFILE=$(mktemp "${TOKENFILE}.XXXXXX")
        trap 'rm -f "${TMPFILE}"' EXIT
        dd if=/dev/urandom bs=32 count=1 status=none \
            | sha256sum -b \
            | cut -f1 -d' ' \
        > "${TMPFILE}"
        chgrp ${TOKENGROUP} "${TMPFILE}"
        chmod 640 "${TMPFILE}"
        mv -fT "${TMPFILE}" ${TOKENFILE}
    ;;
    stop)
        echo -e "Clearing SSRF token"
        rm -f ${TOKENFILE}
    ;;
esac

exit 0
